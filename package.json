{
  "name": "gymhub",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin de Claude Code: registro de gimnasio local con una web que se actualiza sola.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "node scripts/test.mjs",
    "lint": "node scripts/comprobar-web.mjs && claude plugin validate .",
    "test:web": "node scripts/test-web.mjs",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:todo": "node scripts/test-todo.mjs",
    "test:rendimiento": "node scripts/rendimiento.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright-core": "^1.64.1"
  }
}
